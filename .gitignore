.venv/
__pycache__/
*.pyc
.pytest_cache/
# hypothesis's failing-example database (backend/.hypothesis)
.hypothesis/
.coverage
htmlcov/
backend/vendor/
# no trailing slash: a worktree's node_modules symlink is a file, not a directory
node_modules
frontend/.next/
frontend/out/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
.DS_Store
*.log

# local config. `.env*` rather than the two exact names: a stray `.env.bak`
# from editing one, or a `.env.production`, is the same secret in a file git
# was happy to commit.
.env*
!.env.example

# TS incremental build cache
frontend/tsconfig.tsbuildinfo

# `next dev` writes these two itself (next/dist/server/lib/generate-agent-files.js):
# a block of coding instructions for AI agents, plus a CLAUDE.md that imports it.
# Their content is owned by whatever version of Next is installed and changes
# without review, so they are not something this repository should carry — the
# project's own guidance lives in CONTRIBUTING.md and docs/. Untracked, they are
# still written and still read locally; they just cannot ride along in a commit.
frontend/AGENTS.md
frontend/CLAUDE.md

# Written by `next dev`, `next build` and `next typegen`, differently by each:
# dev points the route-type imports at `.next/dev/types/`, the other two at
# `.next/types/`, so a tracked copy flips back and forth with whatever command
# ran last. Next's own docs say it should not be in version control, and
# nothing needs it in the tree: `npm run typecheck` runs `next typegen` first,
# which writes it.
frontend/next-env.d.ts

# Third-party settings / customdata, dropped here while testing an import.
# The project's stance is local-load only: these files are read from the
# browser and never redistributed (NOTICE.txt item 4). Ignoring the two
# directory names Chummer uses keeps an accidental `git add .` from turning
# that stance into a licence problem.
customdata/
settings/
frontend/e2e/.fixtures/
