# VCS / tooling
.git
.github
.claude
.venv
backend/.venv

# build outputs & caches
**/node_modules
**/.next
**/.turbo
**/coverage
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
frontend/tsconfig.tsbuildinfo

# regenerated during the build
backend/vendor

# never belongs in an image
backend/saves
**/.DS_Store
**/*.log
# `**/.env*` rather than the two exact names at the root. `COPY frontend/ ./`
# takes the whole directory, and Next reads `frontend/.env.production` at build
# time and inlines every NEXT_PUBLIC_* value into the client bundle — so a file
# nobody meant to ship ends up readable in a published image, in a layer that
# deleting the file later cannot take back.
**/.env*
!**/.env.example

# not needed at build/runtime (LICENSE + NOTICE.txt are COPYed explicitly)
docs
/README.md
/CONTRIBUTING.md
/CHANGELOG.md
/SECURITY.md
