# Copy to `.env` — `docker compose` reads it automatically.
# Everything here is optional; the values shown are the defaults.

# Port the app (Caddy) listens on.
PORT=8080

# Rate limits, per client IP. A single local user can leave these loose.
RATE_LIMIT=1000/minute
IMPORT_RATE_LIMIT=200/minute

# Reject request bodies larger than this many bytes (12 MiB).
MAX_REQUEST_BYTES=12582912

# Cap on a decompressed .chum5lz (32 MiB) — decompression-bomb guard.
CHUM5_MAX_DECOMPRESSED_BYTES=33554432

# Only needed for a split deploy (UI served from a different origin).
# ALLOWED_ORIGINS=https://chummer.example.com

# chummer5a data commit baked at image build time (default: the pinned SHA).
# Pass to the build:  docker compose build --build-arg CHUMMER_REF=<sha>
# CHUMMER_REF=ed77aa3dcbe760064109d9af01ea9b5e4498294c
