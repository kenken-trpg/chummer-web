// A Worker that fronts a private Cloud Run service (see src/index.ts).
// Deploy from this directory:
//
//   npm install
//   npx wrangler login
//   npx wrangler secret put GCP_SA_KEY   # paste the whole key JSON
//   npx wrangler deploy
//
// See docs/deploy.md › Cloud Run behind a Cloudflare Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chummer-web-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The custom domain below is the only way in, so a WAF rule on the zone
  // cannot be walked around via *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Staged: brought up on `cr.millionskenken.org` first and confirmed there
    // (token minting, host rewrite, /api/ready, the cron) before this name
    // moved over from the Cloudflare Tunnel that used to serve it.
    { "pattern": "chummer-web.millionskenken.org", "custom_domain": true }
  ],
  "vars": {
    // The service's own URL. Also the audience the minted token carries, so
    // it must be exact.
    "RUN_URL": "https://chummer-web-wtwm3u6tiq-an.a.run.app"
  },
  // Keeps one Cloud Run instance alive; see `scheduled` in src/index.ts.
  // Ten minutes, because Cloud Run holds an idle instance for about fifteen.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
