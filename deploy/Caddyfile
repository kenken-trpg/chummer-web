# Edge proxy inside the container. TLS is terminated by the platform
# (Cloud Run / Fly / Cloudflare), so Caddy just serves HTTP on $PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		# Same cap the backend enforces (MAX_REQUEST_BYTES). Bounding it here
		# too means an oversized body - chunked ones included - is dropped at
		# the edge before a byte of it reaches Python.
		request_body {
			max_size {$MAX_REQUEST_BYTES:12582912}
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Only a fallback, hence `?`: set when the upstream sent none. Pages get
		# theirs from Next (`frontend/proxy.ts`), built around a per-request
		# nonce that a static header here cannot carry — overwriting it would
		# put `'unsafe-inline'` back. The API sets its own. What is left is
		# static files, which the browser never renders as a page, so the
		# fallback can afford to allow nothing.
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	}
}
