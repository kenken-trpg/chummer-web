# Edge proxy inside the container. TLS is terminated by the platform
# (Cloud Run / Fly / Cloudflare), so Caddy just serves HTTP on $PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Baseline CSP. script/style keep 'unsafe-inline' because Next's App
		# Router injects inline bootstrap without a nonce; tightening that
		# needs nonce middleware. img/font allow data: (base64 portraits) and
		# blob: (the .chum5 download object URL).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}
}
